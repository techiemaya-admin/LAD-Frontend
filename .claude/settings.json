{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/ci-gate.sh\"",
            "timeout": 300,
            "statusMessage": "Checking CI gates before commit"
          }
        ]
      }
    ]
  }
}
